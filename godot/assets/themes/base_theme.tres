[gd_resource type="Theme" load_steps=2 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/LXGWWenKai-Regular.ttf" id="1_font"]

[resource]
; 设计 token 的真身在 scripts/autoload/ThemeManager.gd::THEMES
; (UI v3 官方色板 = haru / haru_night);本文件仅承载默认字体与兜底控件样式,
; 运行时主题由 ThemeManager._apply_theme_resource 逐 token 重建。
default_font = ExtResource("1_font")
default_font_size = 15

; ---- Button styles ----
Button/colors/font_color = Color(0.9, 0.85, 0.8, 1.0)
Button/colors/font_hover_color = Color(1.0, 1.0, 1.0, 1.0)
Button/colors/font_pressed_color = Color(0.7, 0.65, 0.6, 1.0)
Button/font_sizes/font_size = 14

; ---- Label styles ----
Label/colors/font_color = Color(0.9, 0.85, 0.8, 1.0)
Label/font_sizes/font_size = 14

; ---- LineEdit styles ----
LineEdit/colors/font_color = Color(0.9, 0.85, 0.8, 1.0)
LineEdit/font_sizes/font_size = 14
